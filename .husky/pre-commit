#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# lint js and vue files
npx --no-install lint-staged

# lint only staged ruby files, without invoking Bundler when there are none
ruby_files=$(git diff --name-only --cached --diff-filter=ACMR -- '*.rb')
if [ -n "$ruby_files" ]; then
  printf '%s\n' "$ruby_files" | xargs bundle exec rubocop --force-exclusion
fi

