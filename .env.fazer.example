# Copie para .env na mesma pasta do docker-compose.fazer.yml:
#   cp .env.fazer.example .env

# Obrigatório — gere com: openssl rand -hex 64
SECRET_KEY_BASE=troque_por_um_hex_longo_de_64_bytes

# MFA/2FA — gere com: docker run --rm ghcr.io/fazer-ai/chatwoot:latest bundle exec rails db:encryption:init
# (ou três strings alfanuméricas longas distintas)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=troque_primary_key_32chars_min
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=troque_deterministic_key_32c
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=troque_derivation_salt_32chars

# URL pública da instalação (sem barra no final)
FRONTEND_URL=https://chat.seudominio.com
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=true
DEFAULT_LOCALE=pt_BR

# Postgres (rede interna do compose)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=troque_senha_postgres_forte

# Redis (senha deve bater com REDIS_URL)
REDIS_PASSWORD=troque_senha_redis_forte
REDIS_URL=redis://:troque_senha_redis_forte@redis:6379

# E-mail (ajuste conforme seu provedor)
MAILER_SENDER_EMAIL=Chatwoot <nao-responda@seudominio.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=seudominio.com
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Baileys (opcional — só se for usar WhatsApp não oficial)
# BAILEYS_PROVIDER_DEFAULT_URL=
# BAILEYS_PROVIDER_DEFAULT_API_KEY=
# BAILEYS_PROVIDER_DEFAULT_CLIENT_NAME=chatwoot
