# Modelo de ambiente do serviço baileys-api (T7.1).
# COPIE para `.env` (não versionado, ver .gitignore) e preencha fora do git.
# NENHUM valor real deve ser commitado aqui: só nomes de variáveis e placeholders óbvios.

# --- Serviço baileys-api ---
# Porta interna do serviço dentro da rede do compose (não publicada).
BAILEYS_API_PORT=3000
# Chave exigida pelo fork no cabeçalho `x-api-key` de TODAS as chamadas.
# O fork lê como BAILEYS_PROVIDER_DEFAULT_API_KEY (chatwootnext/.env).
BAILEYS_API_KEY=troque-por-valor-gerado-fora-do-git
# Nome lógico do cliente registrado no provider (fork: BAILEYS_PROVIDER_DEFAULT_CLIENT_NAME).
BAILEYS_CLIENT_NAME=Chatwoot-Connecta
# URL de callback que o fork informa ao provider no setup (webhook da inbox).
# Valor de exemplo: https://fork.exemplo/webhooks/whatsapp/<token>
BAILEYS_WEBHOOK_URL=

# --- Redis do transporte ---
# Senha ÚNICA do Redis deste compose. Obrigatória, nunca literal no compose.
# O fork NÃO usa este Redis; é exclusivo do baileys-api (sessão/fila interna).
BAILEYS_REDIS_PASSWORD=troque-por-valor-gerado-fora-do-git

# --- Nome da sessão/conexão ---
# O baileys-api endereça conexões pelo número de telefone (`/connections/:phone`).
# Este nome documenta QUAL número esta instância atende (só metadado operacional):
# formato E.164 somente dígitos, ex.: 5561999990000.
BAILEYS_SESSION_NAME=5561999990000

# --- Apontamento do fork (referência; configurar no .env DO FORK, não aqui) ---
# No .env do fork (chatwootnext), apontar para este serviço pela rede interna:
#   BAILEYS_PROVIDER_DEFAULT_URL=http://baileys-api:3000
#   BAILEYS_PROVIDER_DEFAULT_API_KEY=<mesmo valor de BAILEYS_API_KEY acima>
#   BAILEYS_PROVIDER_DEFAULT_CLIENT_NAME=<mesmo valor de BAILEYS_CLIENT_NAME acima>
